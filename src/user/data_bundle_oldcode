      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({
          reference,
        }),
      }
    );

    const text = await response.text();

    if (!text) {
      return null;
    }

    let result;

    try {
      result = JSON.parse(text);
    } catch (error) {
      console.error("Invalid data status response:", text);
      return null;
    }

    console.log("DATA STATUS RESPONSE:", result);

    return result;
  } catch (error) {
    console.error("Data status check failed:", error);
    return null;
  }
};

